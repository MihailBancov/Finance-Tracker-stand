# Secret key for Flask sessions (generate a random string for production)
SECRET_KEY=change-me-to-a-long-random-string

# Option A: Single PostgreSQL connection URL (Azure PostgreSQL / Neon / Supabase)
# DATABASE_URL=postgresql://dbadmin:YOUR_PASSWORD@your-server.postgres.database.azure.com:5432/finance_tracker?sslmode=require

# Option B: Individual PostgreSQL parameters (handy for Azure Portal settings; special chars in password are auto-escaped)
# PGHOST=your-server.postgres.database.azure.com
# PGPORT=5432
# PGDATABASE=finance_tracker
# PGUSER=dbadmin
# PGPASSWORD=YOUR_PASSWORD
# PGSSLMODE=require

# Leave DATABASE_URL and PGHOST unset to fall back to local SQLite (finance_tracker.db)
